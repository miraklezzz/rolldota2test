# ── Dota Random ───────────────────────────────────────────────
# Токен бота от @BotFather (обязателен для работы бота)
BOT_TOKEN=

# Адрес страницы на GitHub Pages. Обязательно со слешем на конце.
# Пример: https://username.github.io/dotarandom_bot/
PAGES_URL=

# Публичный HTTPS-адрес локального API (нужен только для телефона):
# туннель cloudflared / ngrok, например https://random-words.trycloudflare.com
# Если PAGES_URL пуст, этот адрес используется и как страница мини-приложения.
PUBLIC_API_URL=

# Локальный сервер
HOST=127.0.0.1
PORT=8765

# Пауза между спинами, секунды
COOLDOWN_SECONDS=3

# Отправлять результат спина в чат Telegram
NOTIFY_ON_SPIN=1

# 1 = принимать спины только с валидным initData (строгая проверка)
STRICT_INITDATA=0
